# Copy to .env and fill in values. Never commit .env.
# LLM_PROVIDER: anthropic | openai   (openai = any OpenAI-compatible API)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required when LLM_PROVIDER=openai (examples of base URLs: https://api.groq.com/openai/v1, https://openrouter.ai/api/v1)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional tuning
PORT=8000
LLM_TIMEOUT_SECONDS=8
LLM_MAX_ATTEMPTS=2
ENABLE_RULE_FALLBACK=true
INTERPRETATION_CACHE_SIZE=512
LOG_LEVEL=INFO
